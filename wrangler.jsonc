// Site estático num Cloudflare Worker, com subdomínio próprio.
{
  "name": "pg-gestao",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "gestao.aranhastudio.pt", "custom_domain": true }]
}
